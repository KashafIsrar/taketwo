# Copy this file to `.env.local` (already .gitignore'd — don't commit real secrets)
# and load it into your shell before running `mvn spring-boot:run`, OR paste
# these into your IDE's Run Configuration > Environment Variables field.
#
# PowerShell, to load all of these in one go from this file:
#   Get-Content .env.local | ForEach-Object {
#     if ($_ -match '^\s*([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] }
#   }

DB_HOST=localhost
DB_PORT=5432
DB_NAME=taketwo_db
DB_USERNAME=taketwo_app
DB_PASSWORD=replace_with_the_password_you_set_in_psql

JWT_SECRET=replace_with_a_long_random_string_for_local_dev_only
JWT_EXPIRATION_MS=86400000

TMDB_API_KEY=replace_with_your_tmdb_api_key
